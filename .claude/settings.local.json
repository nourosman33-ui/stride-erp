{
  "permissions": {
    "allow": [
      "PowerShell(npm view *)",
      "PowerShell(Get-Process *)",
      "PowerShell(Get-NetTCPConnection *)",
      "PowerShell(npm config *)",
      "PowerShell(npx --yes shadcn@latest init -d 2>&1 | Out-String -Width 200)",
      "PowerShell(npm install *)",
      "PowerShell(npx --yes shadcn@latest init --help 2>&1 | Out-String -Width 200)",
      "PowerShell(npm run *)",
      "PowerShell(try { $r = Invoke-WebRequest -Uri \"http://localhost:3001/login\" -UseBasicParsing -TimeoutSec 15; \"STATUS: $\\($r.StatusCode\\)\"; $r.Content.Substring\\(0, [Math]::Min\\(500, $r.Content.Length\\)\\) } catch { $_.Exception.Message })"
    ]
  }
}
