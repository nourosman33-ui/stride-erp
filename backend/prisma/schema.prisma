// STRIDE ERP — Prisma schema
// Phase 0 (Identity, Store, Audit) + Phase 1 (Catalog, Suppliers, Purchasing, Inventory)
// + Phase 2 (Sales / POS)
// Mirrors docs/Database.md. Deviations from that doc are noted inline where they occur:
// Prisma has no portable "generated column" feature, so computed money fields
// (line_total, expected_profit) are calculated in the service layer and persisted,
// not database-generated. Prisma also has no true polymorphic relation, so
// StockLedgerEntry keeps the descriptive reference_type/reference_id pair from
// Database.md *and* adds typed optional FKs for the source documents implemented
// so far (goods receipt, purchase return); later phases add their own FK as they land.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================================
// Phase 0 — Identity, Store, Audit
// ======================================================================

model Store {
  id                       String    @id @default(uuid())
  name                     String
  address                  String?
  phone                    String?
  sizeSqm                  Decimal?  @map("size_sqm") @db.Decimal(8, 2)
  frontageM                Decimal?  @map("frontage_m") @db.Decimal(8, 2)
  openingDate              DateTime? @map("opening_date") @db.Date
  concept                  String?
  targetMarket             String?   @map("target_market")
  currency                 String    @default("EGP")
  vatRate                  Decimal   @default(14.00) @map("vat_rate") @db.Decimal(5, 2)
  poApprovalThreshold      Decimal   @default(5000.00) @map("po_approval_threshold") @db.Decimal(12, 2)
  discountApprovalLimitPct Decimal   @default(10.00) @map("discount_approval_limit_pct") @db.Decimal(5, 2)
  // Atomic per-store counter for sales_order.invoice_number (FR-SAL-1). Incremented via
  // a single UPDATE ... SET invoice_seq = invoice_seq + 1 inside the checkout transaction
  // so concurrent POS terminals never race onto the same number (Postgres row-level
  // locking on UPDATE serializes concurrent increments).
  invoiceSeq               Int       @default(0) @map("invoice_seq")
  // Same atomic-increment pattern as invoiceSeq, for sales_return.return_number.
  returnSeq                Int       @default(0) @map("return_seq")
  isActive                 Boolean   @default(true) @map("is_active")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  // Phase 3 — Settings: branding, receipt, returns, loyalty program configuration.
  logoUrl                  String? @map("logo_url")
  taxNumber                String? @map("tax_number")
  receiptFooterLine1       String? @map("receipt_footer_line1")
  receiptFooterLine2       String? @map("receipt_footer_line2")
  returnPeriodDays         Int     @default(14) @map("return_period_days")
  // Points earned per 1 unit of store currency spent (net of discount, incl. tax) — e.g.
  // 0.10 = 1 point per 10 EGP. Currency value of a single redeemed point.
  loyaltyPointsPerCurrency Decimal @default(0.10) @map("loyalty_points_per_currency") @db.Decimal(6, 4)
  loyaltyPointValue        Decimal @default(1.00) @map("loyalty_point_value") @db.Decimal(6, 4)
  // Lifetime-spend thresholds for tier assignment (derived at read time, never stored on
  // the customer — same "compute, don't cache" principle as stock-on-hand).
  loyaltySilverThreshold   Decimal @default(5000.00) @map("loyalty_silver_threshold") @db.Decimal(12, 2)
  loyaltyGoldThreshold     Decimal @default(15000.00) @map("loyalty_gold_threshold") @db.Decimal(12, 2)
  loyaltyPlatinumThreshold Decimal @default(40000.00) @map("loyalty_platinum_threshold") @db.Decimal(12, 2)

  // Phase 4 — Financial planning. Owner capital put into the business (opening inventory
  // buy-in plus any fit-out). Drives payback-period and ROI in FinanceService; it is
  // capital, never an operating expense, so it never touches the P&L.
  initialInvestment  Decimal   @default(0.00) @map("initial_investment") @db.Decimal(14, 2)
  // Business start date for cumulative/inception-to-date reporting. Falls back to
  // openingDate, then createdAt, when unset.
  financialStartDate DateTime? @map("financial_start_date") @db.Date

  userRoles           UserRole[]
  purchaseOrders      PurchaseOrder[]
  stockLedgerEntries  StockLedgerEntry[]
  movementStatusRule  MovementStatusRule?
  salesOrders         SalesOrder[]
  loyaltyTransactions LoyaltyTransaction[]
  aiConversations     AiConversation[]
  operatingExpenses   OperatingExpense[]
  salesReturns        SalesReturn[]
  feedTokens          FeedToken[]
  dailyExpenses       DailyExpense[]
  cashCounts          CashCount[]

  @@map("store")
}

model User {
  id           String   @id @default(uuid())
  fullName     String   @map("full_name")
  email        String   @unique
  phone        String?
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  userRoles                    UserRole[]
  auditLogs                    AuditLog[]
  priceChangesMade             PriceHistory[]       @relation("PriceChangedBy")
  poApproved                   PurchaseOrder[]      @relation("PoApprovedBy")
  poCreated                    PurchaseOrder[]      @relation("PoCreatedBy")
  goodsReceipts                GoodsReceipt[]       @relation("ReceivedBy")
  stockLedgerEntries           StockLedgerEntry[]   @relation("StockPerformedBy")
  purchaseReturns              PurchaseReturn[]     @relation("PurchaseReturnCreatedBy")
  salesOrders                  SalesOrder[]         @relation("SalesCashier")
  loyaltyTransactionsPerformed LoyaltyTransaction[] @relation("LoyaltyPerformedBy")
  aiConversations              AiConversation[]     @relation("AiConversationOwner")
  operatingExpensesCreated     OperatingExpense[]   @relation("ExpenseCreatedBy")
  salesReturnsProcessed        SalesReturn[]        @relation("ReturnProcessedBy")
  feedTokensCreated            FeedToken[]          @relation("FeedTokenCreatedBy")
  dailyExpensesCreated         DailyExpense[]       @relation("DailyExpenseCreatedBy")
  dailyExpensesApproved        DailyExpense[]       @relation("DailyExpenseApprovedBy")
  dailyExpensesRejected        DailyExpense[]       @relation("DailyExpenseRejectedBy")
  dailyExpensesLastModified    DailyExpense[]       @relation("DailyExpenseLastModifiedBy")
  dailyExpensesDeleted         DailyExpense[]       @relation("DailyExpenseDeletedBy")
  cashCountsCounted            CashCount[]          @relation("CashCountCountedBy")
  cashCountsCreated            CashCount[]          @relation("CashCountCreatedBy")

  @@map("app_user")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // owner | manager | cashier | inventory_clerk | accountant | viewer
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  userRoles UserRole[]

  @@map("role")
}

model UserRole {
  id      String  @id @default(uuid())
  userId  String  @map("user_id")
  roleId  String  @map("role_id")
  storeId String? @map("store_id") // null = access across all stores

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role  Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, storeId])
  @@map("user_role")
}

enum AuditAction {
  create
  update
  delete
  approve
  reject
}

model AuditLog {
  id            String      @id @default(uuid())
  entityType    String      @map("entity_type")
  entityId      String      @map("entity_id")
  action        AuditAction
  performedById String      @map("performed_by")
  beforeValue   Json?       @map("before_value")
  afterValue    Json?       @map("after_value")
  createdAt     DateTime    @default(now()) @map("created_at")

  performedBy User @relation(fields: [performedById], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

// ======================================================================
// Phase 1 — Catalog lookups
// ======================================================================

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]

  @@map("category")
}

model Gender {
  id       String    @id @default(uuid())
  name     String    @unique // Men | Women | Kids | Unisex
  products Product[]

  @@map("gender")
}

model ProductType {
  id       String    @id @default(uuid())
  name     String    @unique // Sneaker | Sandal | Boot | Loafer ...
  products Product[]

  @@map("product_type")
}

model SizeValue {
  id        String @id @default(uuid())
  standard  String // EU | UK | US
  value     String // "42"
  sortOrder Int    @default(0) @map("sort_order")

  variants ProductVariant[]

  @@unique([standard, value])
  @@map("size_value")
}

model Color {
  id      String  @id @default(uuid())
  name    String  @unique
  hexCode String? @map("hex_code")

  variants ProductVariant[]

  @@map("color")
}

// ======================================================================
// Phase 1 — Product Catalog
// ======================================================================

model Product {
  id               String   @id @default(uuid())
  modelName        String   @map("model_name")
  categoryId       String   @map("category_id")
  genderId         String   @map("gender_id")
  productTypeId    String   @map("product_type_id")
  brand            String?
  baseCostPrice    Decimal  @map("base_cost_price") @db.Decimal(12, 2)
  baseSellingPrice Decimal  @map("base_selling_price") @db.Decimal(12, 2)
  description      String?
  imageUrl         String?  @map("image_url")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  category    Category    @relation(fields: [categoryId], references: [id])
  gender      Gender      @relation(fields: [genderId], references: [id])
  productType ProductType @relation(fields: [productTypeId], references: [id])

  variants         ProductVariant[]
  priceHistory     PriceHistory[]
  productSuppliers ProductSupplier[]

  @@index([categoryId])
  @@index([genderId])
  @@index([productTypeId])
  @@map("product")
}

model ProductVariant {
  id                   String   @id @default(uuid())
  productId            String   @map("product_id")
  sizeValueId          String   @map("size_value_id")
  colorId              String   @map("color_id")
  barcode              String   @unique
  sku                  String?  @unique
  costPriceOverride    Decimal? @map("cost_price_override") @db.Decimal(12, 2)
  sellingPriceOverride Decimal? @map("selling_price_override") @db.Decimal(12, 2)
  reorderPoint         Int      @default(0) @map("reorder_point")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  sizeValue SizeValue @relation(fields: [sizeValueId], references: [id])
  color     Color     @relation(fields: [colorId], references: [id])

  priceHistory       PriceHistory[]
  purchaseOrderLines PurchaseOrderLine[]
  stockLedgerEntries StockLedgerEntry[]
  purchaseReturns    PurchaseReturn[]
  salesOrderLines    SalesOrderLine[]
  salesReturnLines   SalesReturnLine[]

  @@unique([productId, sizeValueId, colorId])
  @@map("product_variant")
}

enum PriceField {
  cost_price
  selling_price
}

model PriceHistory {
  id          String     @id @default(uuid())
  productId   String     @map("product_id")
  variantId   String?    @map("variant_id")
  field       PriceField
  oldValue    Decimal?   @map("old_value") @db.Decimal(12, 2)
  newValue    Decimal    @map("new_value") @db.Decimal(12, 2)
  effectiveAt DateTime   @default(now()) @map("effective_at")
  changedById String     @map("changed_by")
  reason      String?

  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  changedBy User            @relation("PriceChangedBy", fields: [changedById], references: [id])

  @@index([productId])
  @@map("price_history")
}

// ======================================================================
// Phase 1 — Suppliers
// ======================================================================

model Supplier {
  id              String   @id @default(uuid())
  name            String
  factoryName     String?  @map("factory_name")
  address         String?
  phone           String?
  whatsapp        String?
  socialContact   String?  @map("social_contact")
  minimumOrder    String?  @map("minimum_order")
  paymentTerms    String?  @map("payment_terms")
  leadTimeDaysMin Int?     @map("lead_time_days_min")
  leadTimeDaysMax Int?     @map("lead_time_days_max")
  qualityRating   Int?     @map("quality_rating") // 1-5, enforced in DTO validation
  notes           String?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  productSuppliers ProductSupplier[]
  purchaseOrders   PurchaseOrder[]
  ledgerEntries    SupplierLedgerEntry[]

  @@index([name])
  @@map("supplier")
}

model ProductSupplier {
  id                String  @id @default(uuid())
  productId         String  @map("product_id")
  supplierId        String  @map("supplier_id")
  supplierCostPrice Decimal @map("supplier_cost_price") @db.Decimal(12, 2)
  piecesPerCarton   Int?    @map("pieces_per_carton")
  isPreferred       Boolean @default(false) @map("is_preferred")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([productId, supplierId])
  @@map("product_supplier")
}

enum SupplierLedgerType {
  deposit
  payment
  credit_note
}

model SupplierLedgerEntry {
  id              String             @id @default(uuid())
  supplierId      String             @map("supplier_id")
  purchaseOrderId String?            @map("purchase_order_id")
  type            SupplierLedgerType
  amount          Decimal            @db.Decimal(12, 2)
  balanceAfter    Decimal            @map("balance_after") @db.Decimal(12, 2)
  note            String?
  createdAt       DateTime           @default(now()) @map("created_at")

  supplier      Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  @@index([supplierId])
  @@map("supplier_ledger_entry")
}

// ======================================================================
// Phase 1 — Purchasing
// ======================================================================

enum PoStatus {
  draft
  pending_approval
  approved
  partially_received
  received
  cancelled
}

model PurchaseOrder {
  id                   String    @id @default(uuid())
  storeId              String    @map("store_id")
  supplierId           String    @map("supplier_id")
  status               PoStatus  @default(draft)
  orderDate            DateTime  @default(now()) @map("order_date")
  expectedDeliveryDate DateTime? @map("expected_delivery_date") @db.Date
  approvedById         String?   @map("approved_by")
  createdById          String    @map("created_by")
  notes                String?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  store      Store    @relation(fields: [storeId], references: [id])
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  approvedBy User?    @relation("PoApprovedBy", fields: [approvedById], references: [id])
  createdBy  User     @relation("PoCreatedBy", fields: [createdById], references: [id])

  lines                 PurchaseOrderLine[]
  goodsReceipts         GoodsReceipt[]
  supplierLedgerEntries SupplierLedgerEntry[]
  purchaseReturns       PurchaseReturn[]

  @@index([storeId, status])
  @@index([supplierId])
  @@map("purchase_order")
}

model PurchaseOrderLine {
  id                  String  @id @default(uuid())
  purchaseOrderId     String  @map("purchase_order_id")
  variantId           String  @map("variant_id")
  quantityOrdered     Int     @map("quantity_ordered")
  cartons             Int?
  piecesPerCarton     Int?    @map("pieces_per_carton")
  costPrice           Decimal @map("cost_price") @db.Decimal(12, 2)
  sellingPriceAtOrder Decimal @map("selling_price_at_order") @db.Decimal(12, 2)
  // lineTotal / expectedProfit computed in service layer at write time — see file header note.
  lineTotal           Decimal @map("line_total") @db.Decimal(14, 2)
  expectedProfit      Decimal @map("expected_profit") @db.Decimal(14, 2)

  purchaseOrder     PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant           ProductVariant     @relation(fields: [variantId], references: [id])
  goodsReceiptLines GoodsReceiptLine[]

  @@index([purchaseOrderId])
  @@map("purchase_order_line")
}

enum GoodsReceiptStatus {
  full
  partial
  discrepancy
}

model GoodsReceipt {
  id              String             @id @default(uuid())
  purchaseOrderId String             @map("purchase_order_id")
  receivedDate    DateTime           @default(now()) @map("received_date")
  receivedById    String             @map("received_by")
  status          GoodsReceiptStatus
  createdAt       DateTime           @default(now()) @map("created_at")

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  receivedBy    User               @relation("ReceivedBy", fields: [receivedById], references: [id])
  lines         GoodsReceiptLine[]

  @@index([purchaseOrderId])
  @@map("goods_receipt")
}

model GoodsReceiptLine {
  id                  String  @id @default(uuid())
  goodsReceiptId      String  @map("goods_receipt_id")
  purchaseOrderLineId String  @map("po_line_id")
  quantityReceived    Int     @map("quantity_received")
  quantityExpected    Int     @map("quantity_expected")
  discrepancyReason   String? @map("discrepancy_reason")

  goodsReceipt       GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLine  PurchaseOrderLine  @relation(fields: [purchaseOrderLineId], references: [id])
  stockLedgerEntries StockLedgerEntry[]

  @@index([goodsReceiptId])
  @@map("goods_receipt_line")
}

model PurchaseReturn {
  id              String   @id @default(uuid())
  purchaseOrderId String?  @map("purchase_order_id")
  variantId       String   @map("variant_id")
  quantity        Int
  reason          String
  createdById     String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  purchaseOrder      PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  variant            ProductVariant     @relation(fields: [variantId], references: [id])
  createdBy          User               @relation("PurchaseReturnCreatedBy", fields: [createdById], references: [id])
  stockLedgerEntries StockLedgerEntry[]

  @@index([variantId])
  @@map("purchase_return")
}

// ======================================================================
// Phase 1 — Inventory: the append-only stock ledger
// (See docs/Database.md section 9.3 for why this must never be a mutable
//  quantity column: it is the structural fix for the source spreadsheet's
//  disconnected Sales Tracker / Inventory Tracker problem.)
// ======================================================================

enum StockEntryType {
  receipt
  sale
  sale_return
  adjustment
  transfer_out
  transfer_in
  count_correction
  purchase_return
}

model StockLedgerEntry {
  id            String         @id @default(uuid())
  storeId       String         @map("store_id")
  variantId     String         @map("variant_id")
  entryType     StockEntryType @map("entry_type")
  quantityDelta Int            @map("quantity_delta") // signed: + increases stock, - decreases
  unitCost      Decimal?       @map("unit_cost") @db.Decimal(12, 2)
  referenceType String?        @map("reference_type") // purchase_order | sales_order | stock_count | manual
  referenceId   String?        @map("reference_id")
  reasonCode    String?        @map("reason_code") // required for entryType = adjustment
  performedById String         @map("performed_by")
  createdAt     DateTime       @default(now()) @map("created_at") // immutable — never updated

  store       Store          @relation(fields: [storeId], references: [id])
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  performedBy User           @relation("StockPerformedBy", fields: [performedById], references: [id])

  goodsReceiptLineId String?           @map("goods_receipt_line_id")
  goodsReceiptLine   GoodsReceiptLine? @relation(fields: [goodsReceiptLineId], references: [id])
  purchaseReturnId   String?           @map("purchase_return_id")
  purchaseReturn     PurchaseReturn?   @relation(fields: [purchaseReturnId], references: [id])

  @@index([storeId, variantId])
  @@index([entryType])
  @@index([createdAt])
  @@map("stock_ledger_entry")
}

model MovementStatusRule {
  storeId                String  @id @map("store_id")
  fastMovingThresholdPct Decimal @default(0.70) @map("fast_moving_threshold_pct") @db.Decimal(4, 2)
  deadStockThresholdPct  Decimal @default(0.10) @map("dead_stock_threshold_pct") @db.Decimal(4, 2)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("movement_status_rule")
}

// ======================================================================
// Phase 2 — Sales / POS
// (See docs/Database.md section 5. Every sale line posts a `sale` stock_ledger_entry
// through InventoryService.postStockMovement — Sales never writes the ledger directly,
// same choke-point rule as Purchasing; see InventoryService header comment. The typed
// FK pattern used for goods_receipt_line/purchase_return is intentionally NOT repeated
// here — StockLedgerEntry.referenceType="sales_order"/referenceId already gives a full
// pointer back to the order without another nullable column, and nothing today needs
// to join from a ledger entry to one specific sale line.)
// ======================================================================

model Customer {
  id        String    @id @default(uuid())
  name      String
  phone     String?   @unique
  email     String?
  gender    String? // free-text (male/female/other) — not the catalog Gender lookup, which is product-facing
  birthDate DateTime? @map("birth_date") @db.Date
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  salesOrders         SalesOrder[]
  loyaltyTransactions LoyaltyTransaction[]
  salesReturns        SalesReturn[]

  @@map("customer")
}

enum SalesOrderStatus {
  completed
  partially_returned
  returned
  voided
}

enum PaymentMethodType {
  cash
  card
  mobile_wallet
  bank_transfer
}

model SalesOrder {
  id             String           @id @default(uuid())
  storeId        String           @map("store_id")
  invoiceNumber  String           @unique @map("invoice_number")
  customerId     String?          @map("customer_id")
  cashierId      String           @map("cashier_id")
  orderDate      DateTime         @default(now()) @map("order_date")
  // subtotal/discountTotal/taxTotal/grandTotal computed in the service layer at write
  // time and persisted, not DB-generated — same reasoning as purchase_order_line's
  // lineTotal/expectedProfit (see file header note).
  subtotal       Decimal          @db.Decimal(12, 2)
  discountTotal  Decimal          @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal       Decimal          @default(0) @map("tax_total") @db.Decimal(12, 2)
  grandTotal     Decimal          @map("grand_total") @db.Decimal(12, 2)
  // Loyalty (FR-CRM/loyalty): snapshotted at sale time, not recomputed later — a change to
  // the store's points-per-currency rate must never rewrite history (same reasoning as
  // purchase_order_line.sellingPriceAtOrder).
  pointsEarned   Int              @default(0) @map("points_earned")
  pointsRedeemed Int              @default(0) @map("points_redeemed")
  // Cash tendered/change — null for non-cash methods where the paid amount always equals
  // grand_total exactly.
  amountTendered Decimal?         @map("amount_tendered") @db.Decimal(12, 2)
  changeDue      Decimal          @default(0) @map("change_due") @db.Decimal(12, 2)
  status         SalesOrderStatus @default(completed)
  createdAt      DateTime         @default(now()) @map("created_at")

  store    Store     @relation(fields: [storeId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  cashier  User      @relation("SalesCashier", fields: [cashierId], references: [id])

  lines         SalesOrderLine[]
  payments      Payment[]
  returns       SalesReturn[]    @relation("ReturnOriginalOrder")
  // Set when this order *is* the replacement raised by an exchange.
  exchangedFrom SalesReturn?     @relation("ReturnExchangeOrder")

  @@index([storeId, orderDate])
  @@map("sales_order")
}

model SalesOrderLine {
  id             String  @id @default(uuid())
  orderId        String  @map("order_id")
  variantId      String  @map("variant_id")
  quantity       Int
  unitPrice      Decimal @map("unit_price") @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  netPrice       Decimal @map("net_price") @db.Decimal(14, 2)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)

  order       SalesOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant    @relation(fields: [variantId], references: [id])
  returnLines SalesReturnLine[]

  @@index([orderId])
  @@map("sales_order_line")
}

model Payment {
  id          String            @id @default(uuid())
  orderId     String            @map("order_id")
  method      PaymentMethodType
  amount      Decimal           @db.Decimal(12, 2)
  referenceNo String?           @map("reference_no")
  createdAt   DateTime          @default(now()) @map("created_at")

  order SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payment")
}

// ======================================================================
// Phase 3 — Loyalty program
// (Append-only ledger, same pattern as stock_ledger_entry: a customer's points balance
// is always SUM(points_delta), never a mutable counter on Customer. Tier is likewise
// derived at read time from lifetime spend against the Store's configured thresholds —
// see CustomersService.)
// ======================================================================

enum LoyaltyTransactionType {
  earn
  redeem
  adjustment
}

model LoyaltyTransaction {
  id            String                 @id @default(uuid())
  customerId    String                 @map("customer_id")
  storeId       String                 @map("store_id")
  type          LoyaltyTransactionType
  pointsDelta   Int                    @map("points_delta") // signed: + earn/adjustment-up, - redeem/adjustment-down
  referenceType String?                @map("reference_type") // sales_order | manual
  referenceId   String?                @map("reference_id")
  performedById String?                @map("performed_by")
  note          String?
  createdAt     DateTime               @default(now()) @map("created_at")

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  store       Store    @relation(fields: [storeId], references: [id])
  performedBy User?    @relation("LoyaltyPerformedBy", fields: [performedById], references: [id])

  @@index([customerId])
  @@index([storeId])
  @@map("loyalty_transaction")
}

// ======================================================================
// Phase 3 — Owner AI Assistant
// (Owner-only, see AiController's @Roles guard. AiToolsService is the only thing that
// touches business data — the provider layer, mock today, real OpenAI later, never
// queries Prisma directly. See AiModule header comment for the provider-swap contract.)
// ======================================================================

enum AiMessageRole {
  user
  assistant
  system
}

model AiConversation {
  id        String   @id @default(uuid())
  ownerId   String   @map("owner_id")
  storeId   String?  @map("store_id")
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner    User        @relation("AiConversationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  store    Store?      @relation(fields: [storeId], references: [id])
  messages AiMessage[]

  @@index([ownerId])
  @@map("ai_conversation")
}

model AiMessage {
  id             String        @id @default(uuid())
  conversationId String        @map("conversation_id")
  role           AiMessageRole
  content        String
  // Records which AiTools ran and their raw results for this message — transparency into
  // what data backed the assistant's answer, and useful for debugging the mock provider.
  toolCalls      Json?         @map("tool_calls")
  createdAt      DateTime      @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_message")
}

// ---------------------------------------------------------------------------
// Phase 4 — Financial planning (owner-only reporting)
// ---------------------------------------------------------------------------

enum ExpenseCategory {
  rent
  utilities
  salaries
  marketing
  logistics
  maintenance
  software
  other
}

enum ExpenseFrequency {
  one_time
  daily
  weekly
  monthly
  quarterly
  yearly
}

/**
 * Recurring and one-off operating costs — the OpEx line of the P&L. Stored as a
 * declared rate plus a frequency rather than materialised per-period rows, so a
 * rent change is one edit instead of a backfill; FinanceService normalises every
 * frequency to a daily rate before applying it to a reporting window.
 * `startDate`/`endDate` bound when the cost actually applies, so closing a cost
 * preserves history instead of rewriting past periods.
 */
model OperatingExpense {
  id          String           @id @default(uuid())
  storeId     String           @map("store_id")
  category    ExpenseCategory
  label       String
  amount      Decimal          @db.Decimal(12, 2)
  frequency   ExpenseFrequency
  startDate   DateTime         @map("start_date") @db.Date
  endDate     DateTime?        @map("end_date") @db.Date
  isActive    Boolean          @default(true) @map("is_active")
  notes       String?
  createdById String?          @map("created_by")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  store     Store @relation(fields: [storeId], references: [id])
  createdBy User? @relation("ExpenseCreatedBy", fields: [createdById], references: [id])

  @@index([storeId, isActive])
  @@index([startDate])
  @@map("operating_expense")
}

// ---------------------------------------------------------------------------
// Phase 5 — Sales returns, refunds and exchanges
// ---------------------------------------------------------------------------

enum ReturnType {
  refund
  exchange
}

/**
 * A customer bringing goods back. Never mutates the original SalesOrder's money columns —
 * history stays immutable exactly like the stock ledger, and the order's `status` plus the
 * returned quantities derived from SalesReturnLine tell the whole story. Revenue is reduced
 * by subtracting returns as contra-revenue in FinanceService, not by editing past sales.
 */
model SalesReturn {
  id              String     @id @default(uuid())
  storeId         String     @map("store_id")
  returnNumber    String     @unique @map("return_number")
  originalOrderId String     @map("original_order_id")
  customerId      String?    @map("customer_id")
  processedById   String     @map("processed_by")
  returnDate      DateTime   @default(now()) @map("return_date")
  type            ReturnType
  reason          String?

  // Value of the goods coming back, mirroring the original sale's tax treatment.
  refundSubtotal Decimal @map("refund_subtotal") @db.Decimal(12, 2)
  refundTaxTotal Decimal @default(0) @map("refund_tax_total") @db.Decimal(12, 2)
  refundTotal    Decimal @map("refund_total") @db.Decimal(12, 2)

  // Exchange only: value of the replacement goods, and what still has to change hands.
  // Positive balanceDue = customer owes; negative = money back to the customer.
  exchangeTotal Decimal @default(0) @map("exchange_total") @db.Decimal(12, 2)
  balanceDue    Decimal @default(0) @map("balance_due") @db.Decimal(12, 2)

  refundMethod   PaymentMethodType? @map("refund_method")
  // Signed: negative claws back points earned on the returned value, positive restores
  // points that were redeemed against it.
  pointsAdjusted Int                @default(0) @map("points_adjusted")

  // The replacement sale raised for an exchange — a normal SalesOrder, so it earns points,
  // deducts stock and appears in reporting like any other sale.
  exchangeOrderId String? @unique @map("exchange_order_id")

  createdAt DateTime @default(now()) @map("created_at")

  store         Store             @relation(fields: [storeId], references: [id])
  originalOrder SalesOrder        @relation("ReturnOriginalOrder", fields: [originalOrderId], references: [id])
  exchangeOrder SalesOrder?       @relation("ReturnExchangeOrder", fields: [exchangeOrderId], references: [id])
  customer      Customer?         @relation(fields: [customerId], references: [id])
  processedBy   User              @relation("ReturnProcessedBy", fields: [processedById], references: [id])
  lines         SalesReturnLine[]

  @@index([storeId, returnDate])
  @@index([originalOrderId])
  @@map("sales_return")
}

model SalesReturnLine {
  id           String  @id @default(uuid())
  returnId     String  @map("return_id")
  orderLineId  String  @map("order_line_id")
  variantId    String  @map("variant_id")
  quantity     Int
  unitPrice    Decimal @map("unit_price") @db.Decimal(12, 2)
  // Refund for this line at the price actually paid (original discount honoured).
  refundAmount Decimal @map("refund_amount") @db.Decimal(12, 2)
  taxAmount    Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  // False for damaged goods: the customer is refunded but the stock is not put back on
  // the shelf, so its cost stays in COGS as a real loss instead of silently reversing.
  restock      Boolean @default(true)
  condition    String?

  salesReturn SalesReturn    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderLine   SalesOrderLine @relation(fields: [orderLineId], references: [id])
  variant     ProductVariant @relation(fields: [variantId], references: [id])

  @@index([returnId])
  @@index([orderLineId])
  @@map("sales_return_line")
}

// ---------------------------------------------------------------------------
// Phase 6 — Excel live feeds
// ---------------------------------------------------------------------------

/**
 * Bearer-in-URL credential for spreadsheet feeds. Excel's Data → From Web cannot send
 * an Authorization header, so the secret travels in the path — the same trade-off
 * calendar (.ics) and "publish to web" links make. Consequences, handled deliberately:
 * - the token is long and random (not guessable, not derived from the store id)
 * - it is READ-ONLY and scoped to one store's reporting feeds
 * - it is revocable, and `lastUsedAt` shows whether a leaked link is being used
 * Anyone holding the URL can read that store's figures, so the UI says so plainly.
 */
model FeedToken {
  id          String    @id @default(uuid())
  token       String    @unique
  storeId     String    @map("store_id")
  label       String
  createdById String    @map("created_by")
  lastUsedAt  DateTime? @map("last_used_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  store     Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy User  @relation("FeedTokenCreatedBy", fields: [createdById], references: [id])

  @@index([storeId])
  @@map("feed_token")
}

// ---------------------------------------------------------------------------
// Phase 7 — Daily Expenses, Approvals & Cash Flow
//
// Deliberately separate from OperatingExpense (Phase 4): that model is for
// RECURRING fixed costs (rent, salaries) declared once with a frequency and
// pro-rated into every reporting window. DailyExpense is for one-off cash-out
// transactions recorded as they happen (water, cleaning supplies, transport).
// The two are combined only in the new financial-dashboard module, never
// inside FinanceService's existing P&L, so neither breaks the other.
// ---------------------------------------------------------------------------

/// Predefined + user-addable category lookup for DailyExpense — unlike
/// OperatingExpense.category (a fixed enum), this is a real table so
/// managers/owners can add categories without a migration.
model DailyExpenseCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  expenses DailyExpense[]

  @@map("daily_expense_category")
}

enum DailyExpenseStatus {
  pending
  approved
  rejected
}

/// Ad-hoc cash-out expense. Cashier-created rows start `pending` and are
/// excluded from every total/dashboard until a manager/owner approves them;
/// manager/owner-created rows auto-approve (self-authority). Never hard-deleted
/// — `deletedAt`/`deletedById`/`deletionReason` preserve the record per the
/// "must not disappear from the DB" requirement; every read path filters
/// `deletedAt: null` except the owner-only deleted-history view.
model DailyExpense {
  id            String            @id @default(uuid())
  storeId       String            @map("store_id")
  categoryId    String            @map("category_id")
  description   String
  amount        Decimal           @db.Decimal(12, 2)
  paymentMethod PaymentMethodType @map("payment_method")
  // Single date+time field, matching SalesOrder.orderDate / SalesReturn.returnDate
  // convention elsewhere in this schema rather than splitting date/time columns.
  occurredAt    DateTime          @map("occurred_at")
  notes         String?

  status          DailyExpenseStatus @default(pending)
  approvedById    String?            @map("approved_by")
  approvedAt      DateTime?          @map("approved_at")
  rejectedById    String?            @map("rejected_by")
  rejectedAt      DateTime?          @map("rejected_at")
  rejectionReason String?            @map("rejection_reason")

  // Receipt attachment — inline columns rather than a generic polymorphic
  // Attachment model, since only DailyExpense needs this today.
  receiptOriginalName String? @map("receipt_original_name")
  // UUID-based; the extension is derived from the validated MIME type at
  // upload time, never from the client-supplied original filename.
  receiptStoredName   String? @map("receipt_stored_name")
  receiptMimeType     String? @map("receipt_mime_type")
  receiptSizeBytes    Int?    @map("receipt_size_bytes")

  createdById      String    @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  lastModifiedById String?   @map("last_modified_by")
  lastModifiedAt   DateTime? @map("last_modified_at")

  deletedAt      DateTime? @map("deleted_at")
  deletedById    String?   @map("deleted_by")
  deletionReason String?   @map("deletion_reason")

  store          Store                @relation(fields: [storeId], references: [id])
  category       DailyExpenseCategory @relation(fields: [categoryId], references: [id])
  createdBy      User                 @relation("DailyExpenseCreatedBy", fields: [createdById], references: [id])
  approvedBy     User?                @relation("DailyExpenseApprovedBy", fields: [approvedById], references: [id])
  rejectedBy     User?                @relation("DailyExpenseRejectedBy", fields: [rejectedById], references: [id])
  lastModifiedBy User?                @relation("DailyExpenseLastModifiedBy", fields: [lastModifiedById], references: [id])
  deletedBy      User?                @relation("DailyExpenseDeletedBy", fields: [deletedById], references: [id])

  @@index([storeId, occurredAt])
  @@index([storeId, status])
  @@index([storeId, deletedAt])
  @@index([categoryId])
  @@index([createdById])
  @@map("daily_expense")
}

/// Daily till reconciliation. Only the two physical-reality inputs (opening
/// cash, actual counted cash) are stored — cash sales, cash expenses, expected
/// closing cash and the variance are always computed live from SalesOrder/
/// Payment/DailyExpense, never duplicated here.
model CashCount {
  id                String    @id @default(uuid())
  storeId           String    @map("store_id")
  countDate         DateTime  @map("count_date") @db.Date
  openingCash       Decimal   @default(0) @map("opening_cash") @db.Decimal(12, 2)
  actualClosingCash Decimal?  @map("actual_closing_cash") @db.Decimal(12, 2)
  countedById       String?   @map("counted_by")
  countedAt         DateTime? @map("counted_at")
  notes             String?

  createdById String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  store     Store @relation(fields: [storeId], references: [id])
  countedBy User? @relation("CashCountCountedBy", fields: [countedById], references: [id])
  createdBy User  @relation("CashCountCreatedBy", fields: [createdById], references: [id])

  @@unique([storeId, countDate])
  @@index([storeId, countDate])
  @@map("cash_count")
}
