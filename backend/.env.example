# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection used by Prisma (see docker-compose.yml for local defaults)
DATABASE_URL="postgresql://stride:stride_dev_password@localhost:5432/stride_erp?schema=public"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_TTL="7d"

# Seed script (prisma/seed.ts) — change the password immediately after first login.
SEED_OWNER_EMAIL="owner@stride-erp.local"
SEED_OWNER_PASSWORD="ChangeMe123!"

# App
PORT=3000
NODE_ENV="development"

# CORS: FRONTEND_PORT is all that's needed — the server trusts any origin on
# this port from localhost, the LAN, or a Tailscale/VPN address (see
# src/common/cors-origin.ts), so it works from other devices without listing
# every possible IP by hand. It never trusts a public-internet origin.
# CORS_ORIGIN adds specific extra origins on top (e.g. a real domain), comma-separated.
FRONTEND_PORT=3001
CORS_ORIGIN=

# Where uploaded expense receipts are stored on disk, relative to the backend's
# working directory (defaults to "uploads" if unset).
UPLOAD_DIR="uploads"
