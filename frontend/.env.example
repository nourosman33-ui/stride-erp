# The API host is resolved at runtime from whatever address the page was loaded
# from (see src/lib/api/client.ts), so the app works whether it's opened via
# localhost, a LAN IP, or a VPN address — no rebuild needed when the network
# path changes. Only the backend's port needs to be known ahead of time.
NEXT_PUBLIC_BACKEND_PORT=3000

# Fallback used only for server-side rendering (no browser `window` available)
# and if the API genuinely lives on a different host than the frontend.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
